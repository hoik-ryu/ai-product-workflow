{
  "schema": "design-change-request/v1",
  "about": "시험 프로젝트 A/B 실험의 UX 명세 차이 D1–D15를 분류 정답 사례로 옮긴 고정 테스트 데이터입니다. 프로젝트 고유 정책(배치 규칙, 명세 수치의 성격, 토큰 밖 여부)은 엔진이 아니라 이 파일의 사실(facts) 값으로 표현합니다. expected는 테스트 전용 필드이며 엔진은 읽지 않습니다.",
  "items": [
    {"id": "D1", "summary": "카카오 가입 안내 줄 제거",
     "facts": [{"kind": "info", "op": "remove", "screen": "SCR-211", "refs": ["UXD-014", "CMP-023"]}],
     "expected": {"status": "classified", "categories": ["info_behavior"]}},
    {"id": "D2", "summary": "'게스트 추가'를 헤더(목록 위)로 이동",
     "facts": [{"kind": "placement", "component": "CMP-001", "screen": "SCR-211", "from": "오른쪽 아래 떠 있음", "to": "헤더", "refs": ["UXD-026"]}],
     "expected": {"status": "conditional", "categories": ["info_behavior"], "possible": ["visual"]}},
    {"id": "D3", "summary": "'게스트 추가'를 둥근 버튼으로(위치 유지)",
     "facts": [{"kind": "style", "component": "CMP-001", "property": "radius", "value": 24, "within_tokens": false}],
     "expected": {"status": "classified", "categories": ["visual"], "flags": ["outside_tokens"]}},
    {"id": "D4", "summary": "브랜드 초록(주 행동 색 값 변경)",
     "facts": [{"kind": "token_value", "token": "color.action.primary", "from": "#1D5BD0", "to": "#0E6B4F"}],
     "expected": {"status": "classified", "categories": ["theme_value"]}},
    {"id": "D5", "summary": "새 의미 색(옅은 강조, 현재 탭, 헤더 띠)",
     "facts": [{"kind": "token_name", "op": "add", "tokens": ["color.action.tint", "color.nav.active", "color.header.bg", "color.header.fg"]}],
     "expected": {"status": "classified", "categories": ["token_semantics"]}},
    {"id": "D6", "summary": "점수를 오른쪽 열로 분리(구분자·정렬 변경)",
     "facts": [{"kind": "notation", "screen": "SCR-211", "refs": ["UXD-074"], "detail": "명세 표기 '이름 · 성별 · 조 · 점수'의 구분자와 정렬 변경"}],
     "expected": {"status": "needs_review", "categories": []}},
    {"id": "D7", "summary": "이름 굵기 Medium",
     "facts": [{"kind": "style", "component": "CMP-024", "property": "font_weight", "value": 500, "within_tokens": false}],
     "expected": {"status": "classified", "categories": ["visual"], "flags": ["outside_tokens"]}},
    {"id": "D8", "summary": "하단 탭 높이 64(명세 56)",
     "facts": [{"kind": "dimension", "component": "CMP-025", "property": "height", "value": 64, "spec": {"value": 56}}],
     "expected": {"status": "conditional", "categories": ["visual"], "possible": ["info_behavior"]}},
    {"id": "D9", "summary": "탭 아이콘 추가",
     "facts": [{"kind": "style", "component": "CMP-025", "property": "icon", "op": "add"}],
     "expected": {"status": "conditional", "categories": ["visual"], "possible": ["info_behavior"]}},
    {"id": "D10", "summary": "헤더 띠 안에 검색",
     "facts": [{"kind": "style", "screen": "SCR-211", "component": "CMP-006", "property": "grouping", "detail": "검색칸을 헤더 띠 영역으로 묶음(정보 순서 동일)"}],
     "expected": {"status": "conditional", "categories": ["visual"], "possible": ["info_behavior"]}},
    {"id": "D11", "summary": "헤더 버튼 보이는 높이 36",
     "facts": [{"kind": "dimension", "component": "CMP-001", "property": "height", "value": 36, "spec": {"values": [44, 48], "bound": "enumerated"}}],
     "expected": {"status": "classified", "categories": ["visual"], "flags": ["spec_conflict"]}},
    {"id": "D12", "summary": "검색칸·칩 테두리 제거",
     "facts": [{"kind": "style", "component": "CMP-006", "property": "border", "op": "remove"},
               {"kind": "style", "component": "CMP-004", "property": "border", "op": "remove"}],
     "expected": {"status": "classified", "categories": ["visual"], "flags": ["accessibility_check"]}},
    {"id": "D13", "summary": "안전 영역 34",
     "facts": [{"kind": "style", "screen": "SCR-211", "property": "safe_area", "value": 34},
               {"kind": "implementation_note", "detail": "안전 영역 가정값 34를 프리뷰에 주입"}],
     "expected": {"status": "classified", "categories": ["visual", "implementation"], "flags": ["new_visual_value"]}},
    {"id": "D14", "summary": "포커스 링이 이전 브랜드 색으로 남음",
     "facts": [{"kind": "token_value", "token": "color.focus.ring", "op": "not_updated"}],
     "expected": {"status": "classified", "categories": ["theme_value"], "flags": ["theme_omission"]}},
    {"id": "D15", "summary": "떠 있는 버튼이 점수 열을 가림",
     "facts": [{"kind": "defect", "refs": ["UXD-026"], "detail": "D6 변경과 결합해 생긴 결함"}],
     "expected": {"status": "excluded", "categories": []}}
  ]
}
